# Copy to .env and fill in. .env is gitignored; never commit real keys.

# Zyte API key — optional. Paid hosted-fetch backend, the last resort for
# sources behind Cloudflare/anti-bot that full Chromium can't clear. No scraper
# needs it today (Green Apple works free; see CONTRIBUTING.md).
# Get one at https://app.zyte.com → Settings → API access.
ZYTE_API_KEY=

# Region for Bedrock (AI tagging). Creds come from the mounted ~/.aws.
AWS_REGION=us-east-1
